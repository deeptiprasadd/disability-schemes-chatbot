OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=gsk_your-key-here
GITHUB_TOKEN=ghp_your-token-here
REPO_NAME=your-username/disability-schemes-chatbot

# ---- LLM provider selection --------------------------------------------
# Which chat model the assistant uses. Default "groq".
# Set to "ollama" to run a LOCAL model with NO external network — this is the
# fix if Groq returns 403 "Access denied" behind a VPN / blocked region.
#   1) install Ollama (https://ollama.com), 2) `ollama pull llama3.1`,
#   3) set LLM_PROVIDER=ollama below.
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# For any OpenAI-compatible endpoint (LLM_PROVIDER=openai):
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://your-endpoint/v1

# ---- Link verification --------------------------------------------------
# Optional. Every link the assistant presents is checked reachable (HEAD/GET)
# before use. When no working link is found in the knowledge base, it will
# fall back to a live web search IF this key is set (https://tavily.com has a
# free tier). Without it, the assistant tells the user honestly that no
# verified link could be found instead of guessing one.
# TAVILY_API_KEY=tvly-your-key-here
